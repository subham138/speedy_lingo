    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Add New Question</h4>
                    </div>
                    <div class="card-body">
                        <form id="questionForm" enctype="multipart/form-data">
                            <!-- Category Selection -->
                            <div class="mb-3">
                                <label for="category_id" class="form-label">Category <span
                                        class="text-danger">*</span></label>
                                <select class="form-select" id="category_id" name="category_id" required>
                                    <option value="">Select Category</option>
                                    <% categories.forEach(cat=> { %>
                                        <option value="<%= cat.id %>">
                                            <%= cat.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <!-- Subcategory Selection -->
                            <div class="mb-3">
                                <label for="sub_category_id" class="form-label">Subcategory <span
                                        class="text-danger">*</span></label>
                                <select class="form-select" id="sub_category_id" name="sub_category_id" required>
                                    <option value="">Select Subcategory</option>
                                    <% subCategories.forEach(sub=> { %>
                                        <option value="<%= sub._id %>" data-category="<%= sub.category_id %>">
                                            <%= sub.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <!-- Question Level -->
                            <div class="mb-3">
                                <label for="question_level" class="form-label">Question Level <span
                                        class="text-danger">*</span></label>
                                <select class="form-select" id="question_level" name="question_level" required>
                                    <option value="">Select Level</option>
                                    <option value="beginner">Beginner</option>
                                    <option value="intermediate">Intermediate</option>
                                    <option value="advanced">Advanced</option>
                                </select>
                            </div>

                            <!-- Question Type -->
                            <div class="mb-3">
                                <label for="question_type" class="form-label">Question Type <span
                                        class="text-danger">*</span></label>
                                <select class="form-select" id="question_type" name="question_type" required>
                                    <option value="">Select Type</option>
                                    <option value="select_correct">Select Correct</option>
                                    <option value="fill_in_blanks">Fill in Blanks</option>
                                    <option value="translate_phrase">Translate Phrase</option>
                                    <option value="describe_image">Describe Image</option>
                                    <option value="audio_sentence">Audio Sentence</option>
                                    <option value="match_pairs">Match Pairs</option>
                                </select>
                            </div>

                            <!-- Question Display In -->
                            <div class="mb-3">
                                <label for="question_display_in" class="form-label">Display In</label>
                                <select class="form-select" id="question_display_in" name="question_display_in">
                                    <option value="both">Both</option>
                                    <option value="inside">Test (After Login)</option>
                                    <option value="outside">Diagnostics Test (Before Login)</option>
                                </select>
                            </div>

                            <!-- Common Fields -->
                            <div class="mb-3">
                                <label for="question_text" class="form-label">Question Text</label>
                                <textarea class="form-control" id="question_text" name="question_text"
                                    rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="information" class="form-label">Information (Hint)</label>
                                <textarea class="form-control" id="information" name="information" rows="2"></textarea>
                            </div>

                            <!-- File Uploads -->
                            <div class="mb-3" id="audioUpload" style="display: none;">
                                <label for="question_audio" class="form-label">Question Audio</label>
                                <input type="file" class="form-control" id="question_audio" name="question_audio"
                                    accept="audio/*">
                            </div>

                            <div class="mb-3" id="imageUpload" style="display: none;">
                                <label for="question_image" class="form-label">Question Image</label>
                                <input type="file" class="form-control" id="question_image" name="question_image"
                                    accept="image/*">
                            </div>

                            <!-- Options Section (for select_correct, fill_in_blanks, translate_phrase, describe_image) -->
                            <div id="optionsSection" style="display: none;">
                                <h5>Options</h5>
                                <div id="optionsContainer">
                                    <div class="option-item mb-2">
                                        <div class="input-group">
                                            <input type="text" class="form-control" name="options[0][text]"
                                                placeholder="Option Text">
                                            <input type="file" class="form-control" name="options[0][audio]"
                                                accept="audio/*" style="max-width: 200px;">
                                            <button type="button" class="btn btn-danger remove-option">Remove</button>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-secondary" id="addOption">Add Option</button>
                            </div>

                            <!-- Correct Answer Section -->
                            <div class="mb-3" id="correctAnswerSection" style="display: none;">
                                <label for="correct_answer" class="form-label">Correct Answer</label>
                                <input type="text" class="form-control" id="correct_answer" name="correct_answer">
                            </div>

                            <!-- Correct Answers (Multiple) -->
                            <div class="mb-3" id="correctAnswersSection" style="display: none;">
                                <label class="form-label">Correct Answers (comma separated)</label>
                                <input type="text" class="form-control" id="correct_answers" name="correct_answers"
                                    placeholder="e.g., lazy,quick">
                            </div>

                            <!-- Word Bank (for audio_sentence) -->
                            <div id="wordBankSection" style="display: none;">
                                <h5>Word Bank</h5>
                                <div id="wordBankContainer">
                                    <div class="word-item mb-2">
                                        <input type="text" class="form-control" name="word_bank[0]" placeholder="Word">
                                        <button type="button" class="btn btn-danger remove-word">Remove</button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-secondary" id="addWord">Add Word</button>
                            </div>

                            <!-- Correct Answer Sequence (for audio_sentence) -->
                            <div class="mb-3" id="sequenceSection" style="display: none;">
                                <label class="form-label">Correct Answer Sequence (comma separated)</label>
                                <input type="text" class="form-control" id="correct_answer_sequence"
                                    name="correct_answer_sequence" placeholder="e.g., The,quick,brown">
                            </div>

                            <!-- Match Pairs Section -->
                            <div id="matchPairsSection" style="display: none;">
                                <h5>Left Options</h5>
                                <div id="leftOptionsContainer">
                                    <div class="left-option-item mb-2">
                                        <input type="text" class="form-control" name="left_options[0][text]"
                                            placeholder="Left Text">
                                        <input type="file" class="form-control" name="left_options[0][audio]"
                                            accept="audio/*" style="max-width: 200px;">
                                        <button type="button" class="btn btn-danger remove-left">Remove</button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-secondary" id="addLeftOption">Add Left
                                    Option</button>

                                <h5 class="mt-3">Right Options</h5>
                                <div id="rightOptionsContainer">
                                    <div class="right-option-item mb-2">
                                        <input type="text" class="form-control" name="right_options[0][text]"
                                            placeholder="Right Text">
                                        <input type="file" class="form-control" name="right_options[0][audio]"
                                            accept="audio/*" style="max-width: 200px;">
                                        <button type="button" class="btn btn-danger remove-right">Remove</button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-secondary" id="addRightOption">Add Right
                                    Option</button>

                                <div class="mb-3">
                                    <label class="form-label">Correct Matches (JSON format)</label>
                                    <textarea class="form-control" id="correct_matches" name="correct_matches" rows="3"
                                        placeholder='[{"left_id": "1", "right_id": "a"}]'></textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success">Save Question</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            const subCatgList = `<%- JSON.stringify(subCategories) %>`
            // Filter subcategories based on category
            $('#category_id').on('change', function () {
                const categoryId = $(this).val();
                $('#sub_category_id').empty().append('<option value="">Select Subcategory</option>');
                if(categoryId > 0){
                    var subCatg = JSON.parse(subCatgList);
                    if(subCatg.length > 0){
                        subCatg = subCatg.filter(sc => sc.category_id == categoryId);
                        subCatg.forEach(sc => {
                            $('#sub_category_id').append('<option value="' + sc.id + '" data-category="' + sc.category_id + '">' + sc.name + '</option>');
                        });
                    }
                }
            });

            // Show/hide sections based on question type
            $('#question_type').change(function () {
                const type = $(this).val();
                $('#audioUpload, #imageUpload, #optionsSection, #correctAnswerSection, #correctAnswersSection, #wordBankSection, #sequenceSection, #matchPairsSection').hide();

                if (['select_correct', 'fill_in_blanks', 'translate_phrase', 'describe_image'].includes(type)) {
                    $('#optionsSection').show();
                    if (type === 'describe_image') {
                        $('#imageUpload').show();
                        $('#correctAnswerSection').show();
                    } else if (type === 'translate_phrase') {
                        $('#correctAnswerSection').show();
                    } else if (type === 'fill_in_blanks') {
                        $('#correctAnswersSection').show();
                    } else {
                        $('#correctAnswerSection').show();
                    }
                } else if (type === 'audio_sentence') {
                    $('#audioUpload').show();
                    $('#wordBankSection').show();
                    $('#sequenceSection').show();
                } else if (type === 'match_pairs') {
                    $('#matchPairsSection').show();
                }
            });

            // Add/Remove options
            $('#addOption').click(function () {
                const index = $('#optionsContainer .option-item').length;
                const optionHtml = `
            <div class="option-item mb-2">
                <div class="input-group">
                    <input type="text" class="form-control" name="options[${index}][text]" placeholder="Option Text">
                    <input type="file" class="form-control" name="options[${index}][audio]" accept="audio/*" style="max-width: 200px;">
                    <button type="button" class="btn btn-danger remove-option">Remove</button>
                </div>
            </div>
        `;
                $('#optionsContainer').append(optionHtml);
            });

            $(document).on('click', '.remove-option', function () {
                $(this).closest('.option-item').remove();
            });

            // Add/Remove words
            $('#addWord').click(function () {
                const index = $('#wordBankContainer .word-item').length;
                const wordHtml = `
            <div class="word-item mb-2">
                <input type="text" class="form-control" name="word_bank[${index}]" placeholder="Word">
                <button type="button" class="btn btn-danger remove-word">Remove</button>
            </div>
        `;
                $('#wordBankContainer').append(wordHtml);
            });

            $(document).on('click', '.remove-word', function () {
                $(this).closest('.word-item').remove();
            });

            // Add/Remove left options
            $('#addLeftOption').click(function () {
                const index = $('#leftOptionsContainer .left-option-item').length;
                const leftHtml = `
            <div class="left-option-item mb-2">
                <input type="text" class="form-control" name="left_options[${index}][text]" placeholder="Left Text">
                <input type="file" class="form-control" name="left_options[${index}][audio]" accept="audio/*" style="max-width: 200px;">
                <button type="button" class="btn btn-danger remove-left">Remove</button>
            </div>
        `;
                $('#leftOptionsContainer').append(leftHtml);
            });

            $(document).on('click', '.remove-left', function () {
                $(this).closest('.left-option-item').remove();
            });

            // Add/Remove right options
            $('#addRightOption').click(function () {
                const index = $('#rightOptionsContainer .right-option-item').length;
                const rightHtml = `
            <div class="right-option-item mb-2">
                <input type="text" class="form-control" name="right_options[${index}][text]" placeholder="Right Text">
                <input type="file" class="form-control" name="right_options[${index}][audio]" accept="audio/*" style="max-width: 200px;">
                <button type="button" class="btn btn-danger remove-right">Remove</button>
            </div>
        `;
                $('#rightOptionsContainer').append(rightHtml);
            });

            $(document).on('click', '.remove-right', function () {
                $(this).closest('.right-option-item').remove();
            });

            // Form submission
            $('#questionForm').submit(function (e) {
                e.preventDefault();
                const formData = new FormData(this);
                // Handle file uploads and send to backend
                $.ajax({
                    url: '/admin/question/add',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        Swal.fire('Success', 'Question added successfully!', 'success');
                        // Reset form or redirect
                    },
                    error: function (xhr) {
                        Swal.fire('Error', xhr.responseJSON.message, 'error');
                    }
                });
            });
        });
    </script>