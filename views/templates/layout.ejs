<!DOCTYPE html>
<html lang="en">
    <% var header = user ? (user.user_type != 'A' ? 'header' : 'admin-header') : 'header',
    topBar = user ? (user.user_type != 'A' ? 'topbar' : 'admin-topbar') : 'topbar';
    console.log(header, topBar)  %>
<%- include(header) %>
<body>
    <%- include(topBar) %>
    <%- body %>
    <%- include('footer') %>
    <% if (typeof script !== 'undefined') {
        if(Array.isArray(script)){
            script.forEach(function(src){ %>
                <script src="<%= src %>"></script>
        <%  });
        } else { %>
            <script src="<%= script %>"></script>
    <% }} %>
    <!-- FLASH MESSAGES SCRIPT -->
    <% if(message){ %>
        <script>
            setTimeout(() => {
                Swal.fire({
                    title: "<%= message.title %>",
                    text: "<%= message.msg %>",
                    icon: "<%= message.type %>" // success, error, warning, info, question
                });
            }, 1000);
        </script>
    <% } %>
</body>
</html>