<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        color: #333;
        overflow-x: hidden;
        position: relative;
    }
    .result-container{
        margin-top: 8%;
    }
</style>
<!-- Particles Background -->
<div id="particles"></div>

<div class="container result-container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Hero Header -->
            <div class="hero-header" data-aos="fade-down">
                <i class="icofont icofont-trophy-alt" style="font-size: 3rem; color: #FFD700; margin-bottom: 20px;"></i>
                <h1 class="display-4 text-white mb-3">Your Test Results</h1>
            </div>

            <!-- Main Results Card -->
            <div class="main-card" data-aos="fade-up">
                <!-- Score Display -->
                <div class="text-center">
                    
                </div>

                <!-- Level Section -->
                <div class="text-center  mb-5" data-aos="fade-up" data-aos-delay="200">
                    <h2 class="mb-3">Your Achievement Level</h2>
                    <div id="percentageHero" class="percentage-hero">0%</div>
                    <div id="levelBadge" class="level-badge level-beginner">Beginner (A1)</div>
                </div>

                <!-- Advice Accordion -->
                <div class="advice-accordion" data-aos="fade-up" data-aos-delay="400">
                    <div class="accordion" id="adviceAccordion">
                        <div id="adviceItem" class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#adviceCollapse">
                                    <i class="icofont icofont-light-bulb me-2"></i> Undestanding Your Score
                                </button>
                            </h2>
                            <div id="adviceCollapse" class="accordion-collapse collapse" data-bs-parent="#adviceAccordion">
                                <div class="accordion-body" id="adviceBody">
                                    <!-- <div class="row align-items-center">
                                        <div class="col-md-6 text-center">
                                            <p class="result-text">Votre Niveau est <span id="rlevel">C1</span> !</p>
                                            <img src="/images/fr_icon.png" alt="FR ISON">
                                        </div>
                                        <div class="col-md-6">
                                            <img src="/images/progress_level.png" alt="Progress Level">
                                        </div>
                                    </div> -->
                                    <div class="row mt-4">
                                        <div class="col-md-12">
                                            <span class="suggestion-heading">The test <u>assessed</u> your <strong>“Understanding”</strong></span>
                                        </div>
                                        <div class="col-md-12 mt-2">
                                            <span class="suggestion-sub-heading">Listening</span>
                                            <p class="suggestion-info mt-2" id="und-lis"></p>
                                        </div>
                                        <div class="col-md-12">
                                            <span class="suggestion-sub-heading">Reading</span>
                                            <p class="suggestion-info mt-2" id="und-read"></p>
                                        </div>
                                        <div class="col-md-12">
                                            <span class="suggestion-heading">The test <u>did not assess</u> your <strong>“Speaking”</strong>.</span>
                                        </div>
                                        <div class="col-md-12 mt-2">
                                            <span class="suggestion-sub-heading">Spoken Interaction</span>
                                            <p class="suggestion-info mt-2" id="spe-spo-int"></p>
                                        </div>
                                        <div class="col-md-12">
                                            <span class="suggestion-sub-heading">Spoken Production</span>
                                            <p class="suggestion-info mt-2" id="spe-spo-pro"></p>
                                        </div>
                                        <div class="col-md-12">
                                            <span class="suggestion-heading">The test <u>did not assess</u> your <strong>“Writing”</strong>.</span>
                                        </div>
                                        <div class="col-md-12 mt-2">
                                            <span class="suggestion-sub-heading">Writing</span>
                                            <p class="suggestion-info mt-2" id="wri-wri"></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-3" data-aos="fade-up" data-aos-delay="600">
                    <a href="/" class="btn btn-custom mt-2 me-3">
                        <i class="icofont icofont-arrow-left me-2"></i> Retake the test
                    </a>
                    <a class="btn btn-custom mt-2" href="/signup">
                        Register with us and start learning! <i class="icofont icofont-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confetti Canvas -->
<canvas id="confettiCanvas" class="confetti-canvas"></canvas>
<script>
    localStorage.setItem('assessment', `<%- JSON.stringify(data) %>`);
</script>