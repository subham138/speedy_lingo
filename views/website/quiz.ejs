<!-- Quiz Section -->
<section id="quiz" class="pb-5"
    style="padding-top: 120px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    <div class="container">
        <!-- Quiz Intro Card -->
        <div class="quiz-intro-card mb-5" id="quizIntro">
            <div class="text-center">
                <h2 class="quiz-title mb-3">Ready to Begin Your Assessment?</h2>
                <p class="quiz-description mb-4">This diagnostic quiz will evaluate your language proficiency across
                    different skills. Answer carefully and enjoy the interactive experience!</p>
                <button class="btn-quiz-start" id="startQuizBtn">
                    <i class="icofont icofont-play me-2"></i>Start Diagnostic Quiz
                </button>
            </div>
        </div>

        <!-- Progress Section -->
        <div id="quizProgress" class="d-none">
            <div class="row mb-4">
                <div class="col-md-8 mx-auto">
                    <div class="progress mb-3" style="height: 12px; border-radius: 20px;">
                        <div class="progress-bar bg-gradient" id="progressBar" role="progressbar"
                            style="width: 0%; transition: width 0.5s ease; border-radius: 20px; background: #218a39;"></div>
                    </div>
                    <div class="text-center">
                        <span class="fw-bold" id="questionCounter">Question 1 of 10</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quiz Questions Container -->
        <div id="quizContainer" class="d-none">
            <!-- Multiple Choice Question -->
            <div class="question question-multiple-choice animate-slide-up" data-qnum="1"
                data-type="multiple-choice">
                <div class="card-body p-4">
                    <div class="question-header mb-4">
                        <h4 class="card-title mb-3">
                            <i class="icofont icofont-question-circle text-primary me-2"></i>
                            Which of the following is a synonym for "happy"?
                        </h4>
                    </div>
                    <div class="options-grid">
                        <div class="option-item" data-value="joyful" data-correct="true">
                            <div class="option-content">
                                <span class="option-letter">A</span>
                                <span class="option-text">Joyful</span>
                            </div>
                        </div>
                        <div class="option-item" data-value="sad" data-correct="false">
                            <div class="option-content">
                                <span class="option-letter">B</span>
                                <span class="option-text">Sad</span>
                            </div>
                        </div>
                        <div class="option-item" data-value="angry" data-correct="false">
                            <div class="option-content">
                                <span class="option-letter">C</span>
                                <span class="option-text">Angry</span>
                            </div>
                        </div>
                        <div class="option-item" data-value="tired" data-correct="false">
                            <div class="option-content">
                                <span class="option-letter">D</span>
                                <span class="option-text">Tired</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fill in the Blanks Question -->
            <div class="question question-fill-blanks animate-slide-up" data-qnum="2" data-type="fill-blanks"
                style="display: none;">
                <div class="card-body p-4">
                    <div class="question-header mb-4">
                        <h4 class="card-title mb-3">
                            <i class="icofont icofont-edit text-success me-2"></i> Complete the sentence:
                        </h4>
                        <p class="blank-sentence">An apple a day keeps the <span class="blank"
                                id="blank1">__________</span> away.</p>
                    </div>
                    <div class="options-grid blanks-options">
                        <div class="option-item blank-option" data-word="doctor" data-correct="true">doctor</div>
                        <div class="option-item blank-option" data-word="teacher" data-correct="false">teacher</div>
                        <div class="option-item blank-option" data-word="rain" data-correct="false">rain</div>
                        <div class="option-item blank-option" data-word="friend" data-correct="false">friend</div>
                    </div>
                </div>
            </div>

            <!-- Voice Question -->
            <div class="question question-voice animate-slide-up" data-qnum="3" data-type="voice"
                style="display: none;">
                <div class="card-body p-4">
                    <div class="question-header mb-4">
                        <h4 class="card-title mb-3">
                            <i class="icofont icofont-audio text-warning me-2"></i>
                            Listen to the audio and select the words you hear.
                        </h4>
                        <div class="voice-controls my-4">
                            <button class="btn btn-play-voice" id="playVoiceBtn">
                                <i class="icofont icofont-play me-2"></i>Play Audio
                            </button>
                            <div class="voice-wave mt-3" id="voiceWave">
                                <div class="wave-bar" style="animation-delay: 0s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.1s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.2s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.3s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.4s;"></div>
                            </div>
                        </div>
                        <div class="voice-line mb-4" id="voiceLine">Click options below to form the sentence.</div>
                    </div>
                    <div class="options-grid voice-options">
                        <div class="option-item voice-option" data-word="The">The</div>
                        <div class="option-item voice-option" data-word="quick">quick</div>
                        <div class="option-item voice-option" data-word="brown">brown</div>
                        <div class="option-item voice-option" data-word="fox">fox</div>
                        <div class="option-item voice-option" data-word="jumps">jumps</div>
                        <div class="option-item voice-option" data-word="over">over</div>
                        <div class="option-item voice-option" data-word="lazy">lazy</div>
                        <div class="option-item voice-option" data-word="dog">dog</div>
                    </div>
                </div>
            </div>

            <!-- Matching Pairs Question -->
            <div class="question question-matching animate-slide-up" data-qnum="4" data-type="matching"
                style="display: none;">
                <div class="card-body p-4">
                    <div class="question-header mb-4">
                        <h4 class="card-title mb-3">
                            <i class="icofont icofont-exchange text-info me-2"></i>
                            Match the countries with their capitals.
                        </h4>
                    </div>
                    <div class="matching-container row">
                        <div class="matching-column col-md-6" id="matching-left">
                            <div class="matching-item" data-match="1">France</div>
                            <div class="matching-item" data-match="2">Japan</div>
                            <div class="matching-item" data-match="3">Canada</div>
                        </div>
                        <div class="matching-column col-md-6" id="matching-right">
                            <div class="matching-item" data-match="3">Ottawa</div>
                            <div class="matching-item" data-match="1">Paris</div>
                            <div class="matching-item" data-match="2">Tokyo</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Translation Question -->
            <div class="question question-translation animate-slide-up" data-qnum="5" data-type="translation"
                style="display: none;">
                <div class="card-body p-4">
                    <div class="question-header mb-4">
                        <h4 class="card-title mb-3">
                            <i class="icofont icofont-world text-danger me-2"></i>
                            Translate "I love learning new languages" to French.
                        </h4>
                    </div>
                    <div class="options-grid translation-options">
                        <div class="option-item" data-value="correct" data-correct="true">
                            <div class="option-content">
                                <span class="option-letter">A</span>
                                <span class="option-text">J'adore apprendre de nouvelles langues.</span>
                            </div>
                        </div>
                        <div class="option-item" data-value="wrong1" data-correct="false">
                            <div class="option-content">
                                <span class="option-letter">B</span>
                                <span class="option-text">Je déteste apprendre les langues.</span>
                            </div>
                        </div>
                        <div class="option-item" data-value="wrong2" data-correct="false">
                            <div class="option-content">
                                <span class="option-letter">C</span>
                                <span class="option-text">J'aime manger des pommes.</span>
                            </div>
                        </div>
                        <div class="option-item" data-value="wrong3" data-correct="false">
                            <div class="option-content">
                                <span class="option-letter">D</span>
                                <span class="option-text">Bonjour, comment ça va?</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="text-center mt-4">
                <button type="button" class="btn btn-secondary me-3 d-none" id="prevBtn">
                    <i class="icofont icofont-arrow-left me-2"></i>Previous
                </button>
                <button type="button" class="btn btn-primary" id="nextBtn">
                    Next <i class="icofont icofont-arrow-right ms-2"></i>
                </button>
                <button type="button" class="btn btn-success d-none" id="submitBtn">
                    <i class="icofont icofont-check me-2"></i>Submit Quiz
                </button>
            </div>
        </div>
    </div>
</section>