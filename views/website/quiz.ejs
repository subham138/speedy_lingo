<div id="clickBlocker"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; background: rgba(0,0,0,0); display: none;">
</div>
<!-- Quiz Section -->
<section id="quiz" class="pb-5"
    style="padding-top: 120px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    <div class="container">
        <!-- Quiz Intro Card -->
        <div class="quiz-intro-card mb-5" id="quizIntro">
            <div class="text-center">
                <h2 class="quiz-title mb-3">Ready to Begin Your Assessment?</h2>
                <p class="quiz-description mb-4">This diagnostic quiz will evaluate your language proficiency across
                    different skills. Answer carefully and enjoy the interactive experience!</p>
                <button class="btn-quiz-start" id="startQuizBtn">
                    <i class="icofont icofont-play me-2"></i>Start Diagnostic Quiz
                </button>
            </div>
        </div>

        <!-- Progress Section -->
        <div id="quizProgress" class="d-none">
            <div class="row mb-4">
                <div class="col-md-8 mx-auto">
                    <div class="progress mb-3" style="height: 12px; border-radius: 20px;">
                        <div class="progress-bar bg-gradient" id="progressBar" role="progressbar"
                            style="width: 0%; transition: width 0.5s ease; border-radius: 20px; background: #218a39;"></div>
                    </div>
                    <div class="text-center">
                        <span class="fw-bold" id="questionCounter">Question 1 of 10</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quiz Questions Container -->
        <div id="quizContainer" class="d-none">
            <%- include('../questTemplate/generate_question.ejs', {data})  %>
            <!-- Navigation Buttons -->
            <div class="text-center mt-4">
                <button type="button" class="btn btn-secondary me-3 d-none" id="prevBtn">
                    <i class="icofont icofont-arrow-left me-2"></i>Previous
                </button>
                <button type="button" class="btn btn-primary" id="nextBtn">
                    Next <i class="icofont icofont-arrow-right ms-2"></i>
                </button>
                <button type="button" class="btn btn-success d-none" id="submitBtn">
                    <i class="icofont icofont-check me-2"></i>Submit Quiz
                </button>
            </div>
        </div>
    </div>
</section>