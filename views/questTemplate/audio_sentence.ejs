<!-- Voice Question -->
<div class="question question-voice animate-slide-up" data-qnum="<%= qnum %>" data-type="audio_sentence" data-id="<%= question.id %>" style="display: <%= display %>;" data-ans-seq="<%= question.correct_answer_sequence.join(',') %>">
    <div class="card-body p-4">
        <div class="question-header mb-4">
            <h4 class="card-title mb-3">
                <i class="icofont icofont-audio text-warning me-2"></i>
                Listen to the audio and select the words you hear.
            </h4>
            <div class="voice-controls my-4">
                <button class="btn btn-play-voice" data-audio-path="<%= question.question_audio %>">
                    <i class="icofont icofont-play me-2"></i>Play Audio
                </button>
                <div class="voice-wave mt-3">
                    <div class="wave-bar" style="animation-delay: 0s;"></div>
                    <div class="wave-bar" style="animation-delay: 0.1s;"></div>
                    <div class="wave-bar" style="animation-delay: 0.2s;"></div>
                    <div class="wave-bar" style="animation-delay: 0.3s;"></div>
                    <div class="wave-bar" style="animation-delay: 0.4s;"></div>
                </div>
            </div>
            <div class="voice-line mb-4" id="voiceLine_<%= qnum %>">Click options below to form the sentence.</div>
        </div>
        <div class="options-grid voice-options">
            <% if(question.word_bank.length > 0){
                let i = 1
                question.word_bank.forEach(opt => { %>
                    <div class="option-item voice-option" data-word="<%= opt %>" data-position="<%= i++ %>"><%= opt %></div>
                <% })
            } %>
        </div>
    </div>
</div>