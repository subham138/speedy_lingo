<!-- Multiple Choice Question / Select Correct One -->
<div class="question question-multiple-choice animate-slide-up" data-qnum="<%= qnum %>" data-type="select-correct" data-id="<%= question.id %>" style="display: <%= display %>;">
    <div class="card-body p-4">
        <div class="question-header mb-4">
            <h4 class="card-title mb-3">
                <i class="icofont icofont-question-circle text-primary me-2"></i>
                <%= question.question_text %>
            </h4>
        </div>
        <div class="options-grid">
            <% if(question.options.length > 0){
                var hasAns = false, ans, isCorrect = false;
                if(question.userAnswer){
                    hasAns = true
                    ans = Array.isArray(question.userAnswer) ? (question.userAnswer.length > 0 ? question.userAnswer[0] : '') : ''
                    isCorrect = question.isCorrect
                }
                let i = 0
                let shuffledOptions = shuffle([...question.options]);
                shuffledOptions.forEach(opt => {
                    var _correct = false, selected = '', ansType = '';
                    if(question.correct_answer == opt.text) _correct = true
                    if(hasAns){
                        if(opt.text == ans){
                            selected = 'selected'
                            ansType = isCorrect ? 'correct-answer' : 'wrong-answer'
                        }
                    }
                    %>
                    <div class="option-item <%= selected %> <%= ansType %>" data-value="<%= opt.text %>" data-correct="<%= _correct %>" data-qnum="<%= qnum %>" data-optIndex="<%= i %>" id="opt-<%= question.id %>-<%= i %>">
                        <div class="option-content">
                            <span class="option-letter"><%= String.fromCharCode(65 + i) %></span>
                            <span class="option-text"><%= opt.text %></span>
                        </div>
                        <div class="audio-option">
                            <button class="btn btn-audio" data-audio-path="select_correct/<%= opt.audio %>">
                                <i class="icofont icofont-play"></i>
                            </button>
                            <div class="voice-wave mt-3" style="display: none;">
                                <div class="wave-bar" style="animation-delay: 0s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.1s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.2s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.3s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.4s;"></div>
                            </div>
                        </div>
                        <!-- <div class="voice-controls">
                            <button class="btn btn-play-voice" id="playVoiceBtn">
                                <i class="icofont icofont-play me-2"></i>
                            </button>
                            <div class="voice-wave mt-3" id="voiceWave">
                                <div class="wave-bar" style="animation-delay: 0s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.1s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.2s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.3s;"></div>
                                <div class="wave-bar" style="animation-delay: 0.4s;"></div>
                            </div>
                        </div> -->
                    </div>
                <% i++ })
            } %>
        </div>
    </div>
</div>