<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-lg"
                style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(248, 250, 252, 0.9)); backdrop-filter: blur(10px);">
                <div class="card-header bg-gradient text-white text-center py-4"
                    style="border: none;">
                    <h3 class="card-title mb-0">
                        <i class="icofont icofont-user-alt-3"></i> Update Your Profile
                    </h3>
                    <p class="mb-0 mt-2 text-dark opacity-75">Keep your information up to date</p>
                </div>
                <div class="card-body p-5">
                    <!-- Profile Image Preview -->
                    <div class="text-center mb-4">
                        <div class="profile-image-container position-relative d-inline-block">
                            <% if (user && user.profile_image) { %>
                                <img src="<%= user.profile_image %>" alt="Profile Image"
                                    class="rounded-circle shadow"
                                    style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;">
                            <% } else { %>
                                <img src="/images//no_image.png" alt="Profile Image" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;">
                            <% } %>
                            <div class="profile-image-overlay position-absolute top-0 start-0 w-100 h-100 rounded-circle d-flex align-items-center justify-content-center opacity-0 hover-opacity-100 transition-all" style="background: rgba(0,0,0,0.5); cursor: pointer;">
                                <i class="icofont icofont-camera text-white" style="font-size: 1.5rem;"></i>
                            </div>
                        </div>
                    </div>

                    <form action="/user/profile" method="post" enctype="multipart/form-data" id="profileForm">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-lg" id="name" name="name"
                                        value="<%= user ? user.name : '' %>" placeholder="Full Name" required>
                                    <label for="name">
                                        <i class="icofont icofont-user me-2"></i>Full Name
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="email" class="form-control form-control-lg" id="email" name="email"
                                        value="<%= user ? user.email : '' %>" placeholder="Email Address" disabled
                                        readonly>
                                    <label for="email">
                                        <i class="icofont icofont-email me-2"></i>Email Address
                                    </label>
                                    <small class="text-muted mt-1 d-block">Email cannot be changed</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="tel" class="form-control form-control-lg" id="phone" name="phone"
                                        value="<%= user ? user.phone : '' %>" placeholder="Phone Number">
                                    <label for="phone">
                                        <i class="icofont icofont-phone me-2"></i>Phone Number
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="file" class="form-control form-control-lg" id="profile_image"
                                        name="profile_image" accept="image/*" style="height: 58px;">
                                    <label for="profile_image">
                                        <i class="icofont icofont-camera me-2"></i>Profile Image
                                    </label>
                                    <small class="text-muted mt-1 d-block">Upload JPG, PNG, or GIF (Max
                                        50MB)</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                            <a href="/user/dashboard" class="btn btn-outline-secondary btn-lg me-md-2">
                                <i class="icofont icofont-arrow-left me-2"></i>Back to Dashboard
                            </a>
                            <button type="submit" class="btn btn-gradient btn-lg px-5">
                                <i class="icofont icofont-check me-2"></i>Update Profile
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card mt-4 border-0 shadow-sm"
                style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(248, 250, 252, 0.8));">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">
                        <i class="icofont icofont-settings me-2"></i>Quick Actions
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="/user/profile/change_password"
                                class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center py-3">
                                <i class="icofont icofont-lock me-2"></i>
                                <span>Change Password</span>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/user/dashboard"
                                class="btn btn-outline-success w-100 d-flex align-items-center justify-content-center py-3">
                                <i class="icofont icofont-dashboard me-2"></i>
                                <span>View Dashboard</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-opacity-100:hover {
        opacity: 1 !important;
    }

    .transition-all {
        transition: all 0.3s ease;
    }

    .btn-gradient {
        background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
    }

    .btn-gradient:hover {
        background: linear-gradient(45deg, #5a6fd8 0%, #6a4190 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    .form-floating>label {
        color: #6c757d;
    }

    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
    }

    .profile-image-container:hover .profile-image-overlay {
        opacity: 1;
    }
</style>

<script>
    document.getElementById('profile_image').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            // Validate file type
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                alert('Please select a valid image file (JPG, PNG, or GIF).');
                e.target.value = '';
                return;
            }

            // Validate file size (50MB)
            if (file.size > 50 * 1024 * 1024) {
                alert('File size must be less than 50MB.');
                e.target.value = '';
                return;
            }

            // Preview image
            const reader = new FileReader();
            reader.onload = function (e) {
                const preview = document.querySelector('.profile-image-container img');
                if (preview) {
                    preview.src = e.target.result;
                } else {
                    // Replace placeholder with image
                    const container = document.querySelector('.profile-image-container');
                    container.innerHTML = `<img src="${e.target.result}" alt="Profile Preview" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;">`;
                }
            };
            reader.readAsDataURL(file);
        }
    });

    // Form validation
    document.getElementById('profileForm').addEventListener('submit', function (e) {
        const name = document.getElementById('name').value.trim();
        const phone = document.getElementById('phone').value.trim();

        if (name.length < 2) {
            e.preventDefault();
            alert('Name must be at least 2 characters long.');
            return;
        }

        if (phone && !/^[\+]?[1-9][\d]{0,15}$/.test(phone.replace(/[\s\-\(\)]/g, ''))) {
            e.preventDefault();
            alert('Please enter a valid phone number.');
            return;
        }
    });
</script>