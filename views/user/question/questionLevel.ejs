<!-- Hero Section -->
<section class="living-room-hero parallax-section">
    <div class="container text-center">
        <h1 class="display-5 text-white animated-text">Living Room Learning</h1>
        <p class="lead text-white-50 animated-text" style="animation-delay: 0.2s;">Master everyday conversations and
            situations in your living room environment.</p>
    </div>
</section>

<!-- Page content -->
<main class="container py-5" style="margin-top: -80px; position: relative; z-index: 10;">
    <div class="row justify-content-center mb-5" data-aos="fade-up">
        <div class="col-lg-6 col-md-8">
            <!-- Level Selector Card -->
            <div class="card learning-card">
                <div class="card-body text-center p-4">
                    <h3 class="fw-bold mb-3">Select Your Level</h3>
                    <div class="level-selector">
                        <span class="level-glider"></span>
                        <button class="level-btn btn active" data-level="beginner">Beginner</button>
                        <button class="level-btn btn" data-level="intermediate">Intermediate</button>
                        <button class="level-btn btn" data-level="advanced">Advanced</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Learning Options -->
    <div class="row g-4">
        <!-- Reading & Writing -->
        <div class="col-md-4">
            <div class="card learning-card h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex align-items-center">
                    <div class="learning-icon" style="background: linear-gradient(45deg, #6f42c1, #6610f2);">
                        <i class="icofont icofont-book-alt"></i>
                    </div>
                    <h4 class="card-title ms-3 mb-0">Reading & Writing</h4>
                </div>
                <div class="card-body p-4">
                    <div class="card-info d-flex justify-content-between text-muted small mb-3">
                        <span><i class="icofont icofont-clock-time me-1"></i> Est. 45 mins</span>
                    </div>
                    <p class="card-text mb-4">Practice with real-life living room scenarios and everyday objects.
                    </p>
                    <ul class="list-unstyled text-start mb-4">
                        <li class="mb-2"><i class="icofont icofont-check-circled text-success me-2"></i>Vocabulary
                            for furniture</li>
                        <li class="mb-2"><i class="icofont icofont-check-circled text-success me-2"></i>Reading
                            comprehension</li>
                    </ul>
                    <div class="progress-wrapper mt-auto">
                        <div class="progress-info d-flex justify-content-between small mb-1 fw-bold">
                            <span>Progress</span>
                            <span>25%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="25" aria-valuemin="0"
                            aria-valuemax="100" style="height: 8px;">
                            <div class="progress-bar" style="width: 25%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <button type="button" class="btn btn-quiz-start btn-quiz w-100" data-type="learning">Start
                        Learning</button>
                </div>
            </div>
        </div>

        <!-- Listening & Speaking -->
        <div class="col-md-4">
            <div class="card learning-card h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex align-items-center">
                    <div class="learning-icon" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0);">
                        <i class="icofont icofont-headphone-alt"></i>
                    </div>
                    <h4 class="card-title ms-3 mb-0">Listening & Speaking</h4>
                </div>
                <div class="card-body p-4">
                    <div class="card-info d-flex justify-content-between text-muted small mb-3">
                        <span><i class="icofont icofont-clock-time me-1"></i> Est. 30 mins</span>
                    </div>
                    <p class="card-text mb-4">Enhance your skills with interactive audio lessons and dialogues.</p>
                    <ul class="list-unstyled text-start mb-4">
                        <li class="mb-2"><i class="icofont icofont-check-circled text-success me-2"></i>Audio
                            conversations</li>
                        <li class="mb-2"><i class="icofont icofont-check-circled text-success me-2"></i>Pronunciation
                            practice</li>
                    </ul>
                    <div class="progress-wrapper mt-auto">
                        <div class="progress-info d-flex justify-content-between small mb-1 fw-bold">
                            <span>Progress</span>
                            <span>0%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
                            style="height: 8px;">
                            <div class="progress-bar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <button type="button" class="btn btn-quiz-start btn-quiz w-100" data-type="listening">Start
                        Practice</button>
                </div>
            </div>
        </div>

        <!-- Fluent Conversation -->
        <div class="col-md-4">
            <div class="card learning-card h-100">
                <div class="card-header bg-transparent border-0 p-4 d-flex align-items-center">
                    <div class="learning-icon" style="background: linear-gradient(45deg, #198754, #20c997);">
                        <i class="icofont icofont-people"></i>
                    </div>
                    <h4 class="card-title ms-3 mb-0">Fluent Conversation</h4>
                </div>
                <div class="card-body p-4">
                    <div class="card-info d-flex justify-content-between text-muted small mb-3">
                        <span><i class="icofont icofont-clock-time me-1"></i> Est. 60 mins</span>
                    </div>
                    <p class="card-text mb-4">Improve your fluency with our AI-powered conversation partner.</p>
                    <ul class="list-unstyled text-start mb-4">
                        <li class="mb-2"><i class="icofont icofont-check-circled text-success me-2"></i>AI
                            conversation partner</li>
                        <li class="mb-2"><i class="icofont icofont-check-circled text-success me-2"></i>Real-time
                            feedback</li>
                    </ul>
                    <div class="progress-wrapper mt-auto">
                        <div class="progress-info d-flex justify-content-between small mb-1 fw-bold">
                            <span>Progress</span>
                            <span>0%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
                            style="height: 8px;">
                            <div class="progress-bar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-4 pt-0">
                    <a href="/user/booking" type="button" class="btn btn-quiz-start w-100"
                        data-type="conversation">Start Chatting</a>
                </div>
            </div>
        </div>
    </div>
</main>

<input type="hidden" id="catg_id" value="<%= queryData.catg_id %>">
<input type="hidden" id="sub_catg_id" value="<%= queryData.sub_catg_id %>">

<script>
    $('.btn-quiz-start.btn-quiz').on('click', function () {
        const level = $('.level-btn.active').data('level')
        const catg_id = $('#catg_id').val()
        const sub_catg_id = $('#sub_catg_id').val(),
            quest_type = $(this).data('type');
        let enc_dt = encryptData({ level, catg_id, sub_catg_id, quest_type })
        window.location.href = `/user/questions/question?enc_dt=${enc_dt}`
    })
</script>