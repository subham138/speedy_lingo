<div class="success-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="success-card" data-aos="fade-up" data-aos-duration="1000">
                    <div class="success-icon" data-aos="zoom-in" data-aos-delay="500">
                        <i class="icofont icofont-check-circled"></i>
                    </div>
                    <h1 class="success-title" data-aos="fade-in" data-aos-delay="700">Subscription Successful!</h1>
                    <p class="success-message" data-aos="fade-in" data-aos-delay="900">
                        Congratulations! Your subscription has been activated successfully. You can now enjoy all
                        premium features and manage your subscription details.
                    </p>
                    <div class="success-features" data-aos="fade-in" data-aos-delay="1100">
                        <div class="feature-item">
                            <i class="icofont icofont-star"></i>
                            <span>Unlimited access to all courses</span>
                        </div>
                        <div class="feature-item">
                            <i class="icofont icofont-chart-line"></i>
                            <span>Advanced progress tracking</span>
                        </div>
                        <div class="feature-item">
                            <i class="icofont icofont-certificate-alt-1"></i>
                            <span>Certificate of completion</span>
                        </div>
                    </div>
                    <form action="/create-portal-session" method="POST" data-aos="fade-in" data-aos-delay="1300">
                        <input type="hidden" name="customer_id" value="<%= customerId %>">
                        <button type="submit" class="btn btn-success-portal">
                            <i class="icofont icofont-settings"></i>
                            Go to Customer Portal
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>