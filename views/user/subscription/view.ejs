<script async src="https://js.stripe.com/v3/pricing-table.js"></script>
<section class="py-5 bg-light" id="pricing">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Choose Your Plan</h2>
        <div class="row g-4 justify-content-center">
            <div class="com-md-12">
                <stripe-pricing-table pricing-table-id="<%= publishable_key %>"
                    publishable-key="<%= pricing_table_id %>"
                    customer-email="<%= user.email %>"
                    customer-id="<%= user.stripe_customer_id !=='undefined' || user.stripe_customer_id ? user.stripe_customer_id : '' %>"
                    >
                </stripe-pricing-table>
            </div>
        </div>
    </div>
</section>